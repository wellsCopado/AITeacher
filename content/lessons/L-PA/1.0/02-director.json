  "hotspots": [
    {
      "id": "fence",
      "label": "卷尺",
      "anchor": "fence",
      "teaches": "MC.perim_area_swap",
      "language_pack": {
        "zh": "调查员沿着调查区的边拉一圈卷尺。拉一圈用了多少米，就是周长，单位是米。",
        "en": [
          "The tape goes all the way around the survey area. Its length is the perimeter.",
          "perimeter — 周长。",
          "Pull the tape around the edge."
        ]
      }
    },
    {
      "id": "tile",
      "label": "样方",
      "anchor": "tile",
      "teaches": "MC.perim_area_swap",
      "language_pack": {
        "zh": "白色方框叫样方，每个围住 1 平方米的海底。铺满调查区需要几个样方，就是面积。",
        "en": [
          "Each white frame covers one square metre of sea floor. The number of frames is the area.",
          "quadrat — 样方；area — 面积。",
          "Tap “放样方” and count the frames."
        ]
      }
    },
    {
      "id": "unit",
      "label": "单位",
      "anchor": "unit",
      "teaches": "MC.unit_len_vs_area",
      "language_pack": {
        "zh": "卷尺上一大格是 1 米；一个样方是 1 平方米。长度和面积用的单位不一样。",
        "en": [
          "One mark on the tape is one metre. One frame is one square metre.",
          "metre, square metre — 米，平方米。",
          "Point to one metre, then one square metre."
        ]
      }
    },
    {
      "id": "shrimp",
      "label": "螳螂虾的洞",
      "anchor": "shrimp",
      "teaches": "M.MEAS.length_cm_m",
      "facts": [
        {
          "text": "孔雀螳螂虾成年体长常见约 10–18 厘米",
          "ref": "待科学审核"
        },
        {
          "text": "捕肢挥击速度最高约 23 米/秒",
          "ref": "Patek, Korff & Caldwell 2004, Nature 428:819"
        }
      ],
      "language_pack": {
        "zh": "这是孔雀螳螂虾的洞口。孔雀螳螂虾成年后身长常见约 10 到 18 厘米，平时躲在珊瑚礁附近沙石里的洞中。它挥出捕肢的速度最快约每秒 23 米。比一比：它的身长和 1 米的样方边相比，差多少？",
        "en": [
          "This is the burrow of a peacock mantis shrimp. It is about 10 to 18 centimetres long.",
          "mantis shrimp — 螳螂虾；centimetre — 厘米。",
          "Compare its body with one metre."
        ]
      }
    }
  ],
  "challenges": [
    {
      "id": "c1",
      "prompt": "新的调查区长 5 米、宽 3 米。拉一圈卷尺要多少？铺满要几个 1 平方米的样方？",
      "with_theme": true,
      "answers": [
        {
          "field": "P",
          "label": "卷尺",
          "value": 16,
          "unit": "米"
        },
        {
          "field": "S",
          "label": "样方",
          "value": 15,
          "unit": "平方米"
        }
      ],
      "hints": [
        "卷尺沿着边走：5+3+5+3。",
        "样方是 3 行，每行 5 个。",
        "卷尺量长度用“米”，样方数面积用“平方米”。"
      ]
    },
    {
      "id": "c2",
      "prompt": "卷尺只有 16 米长。调查区的长和宽是多少时，能铺下的样方最多？",
      "with_theme": true,
      "answers": [
        {
          "field": "a",
          "label": "长",
          "value": 4,
          "unit": "米"
        },
        {
          "field": "b",
          "label": "宽",
          "value": 4,
          "unit": "米"
        },
        {
          "field": "S",
          "label": "样方",
          "value": 16,
          "unit": "平方米"
        }
      ],
      "hints": [
        "长 + 宽 = 8。",
        "试试 7 和 1、6 和 2、5 和 3、4 和 4。",
        "比一比每种能放几个样方。"
      ]
    },
    {
      "id": "c3",
      "prompt": "一个长方形长 7 厘米、宽 2 厘米。周长是多少？面积是多少？",
      "with_theme": false,
      "answers": [
        {
          "field": "P",
          "label": "周长",
          "value": 18,
          "unit": "厘米"
        },
        {
          "field": "S",
          "label": "面积",
          "value": 14,
          "unit": "平方厘米"
        }
      ],
      "hints": [
        "7+2+7+2。",
        "2 行，每行 7 个 1 平方厘米。",
        "注意单位换成了厘米。"
      ]
    }
  ],
