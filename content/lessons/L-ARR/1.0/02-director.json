{
  "title": "一排排的积木：用阵列看懂乘法",
  "intro": {
    "headline": "桌上有一盘木头积木，一排一排摆得整整齐齐。",
    "paragraphs": [
      "每一排的积木一样多。我们一排一排地数，看看能不能不用一个一个数，就知道一共有多少块。"
    ]
  },
  "scene_component_ids": [
    "ArrayMultiplier@1.0"
  ],
  "component_params": {
    "ArrayMultiplier": {
      "rows": 3,
      "cols": 4,
      "theme": "blocks"
    }
  },
  "experiment_model_version": {
    "id": "array-mul",
    "ver": "1.0.0",
    "deterministic": true,
    "vars": {
      "rows": {
        "unit": "行",
        "min": 1,
        "max": 9,
        "step": 1
      },
      "cols": {
        "unit": "个",
        "min": 1,
        "max": 9,
        "step": 1
      }
    },
    "outputs": {
      "total": {
        "expr": "rows*cols",
        "unit": "个"
      }
    },
    "reference_cases": [
      {
        "in": {
          "rows": 3,
          "cols": 4
        },
        "out": {
          "total": 12
        }
      },
      {
        "in": {
          "rows": 4,
          "cols": 3
        },
        "out": {
          "total": 12
        }
      },
      {
        "in": {
          "rows": 1,
          "cols": 9
        },
        "out": {
          "total": 9
        }
      },
      {
        "in": {
          "rows": 0,
          "cols": 4
        },
        "expect": "reject_out_of_range"
      }
    ]
  },
