{
  "name": "ai-discovery-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Discovery World：数学兴趣 3D 教学内容系统（Skill、校验器、命令行工具、组件与应用）",
  "scripts": {
    "dls": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node scripts/e2e-preview.mjs",
    "build": "node scripts/build-apps.mjs",
    "start": "node scripts/build-apps.mjs && tsx apps/server/src/main.ts",
    "dev:server": "tsx apps/server/src/main.ts",
    "e2e:apps": "tsx scripts/e2e-apps.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "three": "0.160.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7"
  },
  "packageManager": "pnpm@10.28.0"
}
