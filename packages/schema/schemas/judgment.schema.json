{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-discovery-world/schemas/judgment-1.0.json",
  "title": "LearningJudgment",
  "description": "一次作业的判断：事实、可能的缺口、还不知道的、下一课建议，加掌握状态和家长卡草稿（BL07、BL08、BL10）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["homework_ref", "child", "facts", "gaps", "unknowns", "next", "mastery", "parent_card"],
  "properties": {
    "id": { "type": "string", "pattern": "^LJ-\\d{4,}$" },
    "homework_ref": { "type": "string", "pattern": "^HW-\\d{4,}$" },
    "child": { "type": "string" },
    "facts": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["text", "items"],
        "properties": { "text": { "type": "string", "minLength": 1 }, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["concept_id", "text", "confidence", "verify_by", "items"],
        "properties": {
          "concept_id": { "type": "string" },
          "misconception": { "type": ["string", "null"] },
          "text": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "verify_by": { "type": "string", "minLength": 1 },
          "items": { "type": "array", "items": { "type": "string" } }
        } }
    },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "next": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["kind", "text"],
        "properties": { "kind": { "enum": ["重教", "巩固", "新课", "观察"] }, "concept_id": { "type": ["string", "null"] }, "text": { "type": "string", "minLength": 1 } } }
    },
    "mastery": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["concept_id", "state", "evidence"],
        "properties": {
          "concept_id": { "type": "string" },
          "state": { "enum": ["未观察", "待确认", "有独立应用证据", "需再支持"] },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "作业题号（如 3）或课内记录（lesson:L-PA@1.0）" }
        } }
    },
    "corrects": {
      "type": "array",
      "description": "被新证据推翻的旧推测；旧判断原文保留，标「已更正」",
      "items": { "type": "object", "additionalProperties": false, "required": ["judgment_id", "gap", "note"],
        "properties": { "judgment_id": { "type": "string", "pattern": "^LJ-\\d{4,}$" }, "gap": { "type": "integer", "minimum": 0 }, "note": { "type": "string", "minLength": 1 } } }
    },
    "parent_card": {
      "type": "object", "additionalProperties": false, "required": ["facts", "child_share", "unverified", "talk"],
      "properties": {
        "facts": { "type": "string", "minLength": 1 },
        "child_share": { "type": "string" },
        "unverified": { "type": "string" },
        "talk": { "type": "string", "minLength": 1 }
      }
    }
  }
}
